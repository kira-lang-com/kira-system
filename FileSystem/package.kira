construct FileSystem extends Package {
    let version: String = "26.10.4"
    let kind: PackageKind = .Library
    // The platform's own file chooser. Every operating system has one and none
    // of them expose it through the C standard library, so the three answers
    // live behind one call — the same shape the appearance shim in KiraUI takes.
    //
    // The system libraries differ per platform and are named per target rather
    // than globally: a Windows link line needs the COM and shell libraries the
    // dialog lives in, a macOS one needs AppKit (reached through the Objective-C
    // runtime, so the shim stays C), and Linux has no dialog library at all —
    // there the shim runs the desktop's chooser as a helper process.
    let nativeLibraries: [NativeLibrary] = [
        NativeLibrary {
            name: "kirasystemdialogs",
            linkMode: LinkMode.Static,
            headers: Headers {
                entrypoint: "NativeLibs/Dialogs/kira_system_dialogs.h",
                includeDirs: ["NativeLibs/Dialogs"]
            },
            sources: ["NativeLibs/Dialogs/kira_system_dialogs.c"],
            autobind: Autobind {
                module: "dialogs",
                headers: ["NativeLibs/Dialogs/kira_system_dialogs.h"],
                mode: AutobindMode.AllPublic
            },
            nativeTargets: [
                NativeTarget {
                    triple: "x86_64-windows-msvc",
                    systemLibs: ["ole32", "shell32", "user32"]
                },
                NativeTarget {
                    triple: "aarch64-macos-none",
                    frameworks: ["Foundation", "AppKit"],
                    systemLibs: ["objc"]
                },
                NativeTarget {
                    triple: "x86_64-macos-none",
                    frameworks: ["Foundation", "AppKit"],
                    systemLibs: ["objc"]
                },
                NativeTarget { triple: "x86_64-linux-gnu" }
            ]
        }
    ]
}

// The platform's file chooser.
//
// An application that draws its own chooser draws one that knows nothing: not
// the user's sidebar, not their recents or tags, not the volumes their file
// manager mounted, not the shortcuts they type without thinking. Every platform
// ships the real one, and it is the only one the user has learned — so this is
// the whole of the surface: ask, and get back a path.
//
// A cancel is an ordinary answer, not a failure: it is the empty string. That is
// what makes `if folder.count > 0` the complete handling of one of these calls,
// and it is the same answer a platform with no chooser at all gives.
//
// The call BLOCKS while the dialog is up, and must be made from the thread that
// owns the application's windows — the main thread, which for a Kira UI
// application is where every widget action already runs.

// Choose one existing directory. `title` labels the dialog and `start` is the
// directory it opens in; either may be empty for the platform's default.
@Native
function pickFolderIn(title: borrow String, start: borrow String) -> String {
    return kira_system_pick_folder(title, start)
}

// Choose a directory with the platform's own defaults — the shape almost every
// caller wants: `let folder = FileSystem.pickFolder()`.
@Native
function pickFolder() -> String {
    return pickFolderIn("", "")
}

// Choose one existing file.
@Native
function pickFileIn(title: borrow String, start: borrow String) -> String {
    return kira_system_pick_file(title, start)
}

@Native
function pickFile() -> String {
    return pickFileIn("", "")
}

// Name a file that need not exist yet (the save panel). `suggested` is the file
// name the dialog opens with.
@Native
function pickSavePath(title: borrow String, start: borrow String, suggested: borrow String) -> String {
    return kira_system_pick_save_path(title, start, suggested)
}

// Which chooser this build talks to: "windows", "macos", "portal" (a Linux
// desktop helper) or "none". Callers that must not block on a chooser they
// cannot get can ask first; everything else reads an empty path as a cancel.
@Native
function dialogBackend() -> String {
    return kira_system_dialog_backend()
}

// Whether this platform can show a chooser at all.
function canPick() -> Bool {
    return dialogBackend() != "none"
}
